{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI网关",
  "version": "0.1.0",
  "identifier": "com.ai-gateway.desktop",
  "build": {
    "frontendDist": "web/dist"
  },
  "bundle": {
    "icon": [
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/ai-gateway-daemon"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI网关",
        "width": 900,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  }
}
