{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Gateway",
  "version": "0.1.0",
  "identifier": "com.ai-gateway.client",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Gateway",
        "width": 900,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:4242"
    }
  }
}
